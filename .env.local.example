# Public — exposed to the browser. Set these for both dev and prod.
# Backend base URL without trailing slash (Next.js frontend runs on 3000, backend on 5000 by default)
NEXT_PUBLIC_API_URL=http://localhost:5000

# X-Api-Key is only required if the backend's API_KEYS list contains entries.
# Leave blank in dev unless you've set API_KEYS in the backend .env.
NEXT_PUBLIC_API_KEY=

# Razorpay (publishable key id only — NEVER put the secret in the frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Google Places API (live Google reviews on the homepage) ───────────────────
# Server-only — never prefix with NEXT_PUBLIC_, this key must not reach the browser.
# Setup: Google Cloud Console → enable "Places API (New)" → create an API key
# restricted to that API → find your Place ID at
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Leave blank to skip Google reviews — the section is hidden from the homepage entirely.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Cloudinary (product image/video hosting) ──────────────────────────────────
# Server-only — never prefix with NEXT_PUBLIC_, these must not reach the browser.
# Used only by the one-off migration script (scripts/migrate-media-to-cloudinary.mjs).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Supabase Auth ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix with NEXT_PUBLIC_. Used only for admin-level
# operations (none yet); safe to leave blank until one is actually needed.
SUPABASE_SERVICE_ROLE_KEY=
# Used to build email-confirmation/reset links from Server Actions, which have
# no request object to read an origin from. Set to your real domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudflare Turnstile (signup CAPTCHA) ──────────────────────────────────────
# Enable "Attack Protection → CAPTCHA" in Supabase Auth settings with your
# Turnstile secret key, then put the matching site key here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
