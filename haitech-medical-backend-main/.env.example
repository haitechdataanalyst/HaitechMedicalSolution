# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# PostgreSQL Configuration
# For a hosted provider (e.g. Supabase): use the "Session pooler" or direct
# connection details from Project Settings → Database (NOT the "Transaction
# pooler" — this backend holds a persistent connection pool, and the
# transaction pooler breaks prepared statements unless you also pass
# `prepare: false`, which isn't wired up here). Set POSTGRES_SSL=true.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=password
POSTGRES_DB=myapp
POSTGRES_SSL=false

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-must-be-at-least-100-characters-long-so-keep-adding-more-characters-until-you-reach-the-minimum-length
JWT_ACCESS_EXPIRY_TIME=30
JWT_REFRESH_EXPIRY_TIME=30
JWT_RESET_PASSWORD_EXPIRY=30
JWT_EMAIL_VERIFICATION_EXPIRY=30

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_TLS_ENABLED=false
REDIS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_BREAKER_COOLDOWN_MS=30000
REDIS_CIRCUIT_BREAKER_TIMEOUT_MS=2500

# Logging
ENABLE_PAYLOAD_LOGGING=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend URL used in password reset / email verification links
FRONTEND_URL=http://localhost:3000

# Google OAuth — server-side verification of ID tokens
GOOGLE_CLIENT_ID=

# Razorpay (server-side only — key secret is never sent to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP (email service — leave blank in dev to skip sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Haitech Medical <no-reply@haitechmedical.com.au>"

# DTDC Courier Integration
# PX API (shipment booking / label generation) — api-key header auth
DTDC_PX_API_KEY=
DTDC_CUSTOMER_CODE=
DTDC_PX_BASE_URL=https://blktapi.dtdc.com/v3
DTDC_ORIGIN_PINCODE=400001

# Tracking API — username/password token auth (token auto-cached 23 h)
DTDC_TRACKING_USERNAME=
DTDC_TRACKING_PASSWORD=
DTDC_TRACKING_BASE_URL=https://blktapi.dtdc.com/v3

# Pincode serviceability — Bearer token auth
DTDC_PINCODE_BEARER=
DTDC_PINCODE_BASE_URL=https://blktapi.dtdc.com/v3